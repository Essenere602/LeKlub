# Variables publiques Expo.
# Elles sont intégrées au bundle mobile : ne jamais y placer de secret.
# Dev iPhone physique : utiliser l'IP locale du Mac.
# Production cible : utiliser https:// pour l'API et wss:// pour le WebSocket.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:8081
